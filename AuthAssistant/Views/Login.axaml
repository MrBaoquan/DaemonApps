<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 
			 xmlns:vm="using:AuthAssistant.ViewModels"
			 x:DataType="vm:MainWindowViewModel" 
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
			 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:p1="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
			 xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             x:Class="AuthAssistant.Login">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>
	
	<DockPanel Margin="0">
		<StackPanel DockPanel.Dock="Top" Margin="0">
			<!-- 标题区域 -->
			<Border Background="#3F51B5" Padding="24 30">
				<StackPanel HorizontalAlignment="Center">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<avalonia:MaterialIcon Kind="ShieldAccount" Width="32" Height="32" Foreground="White"/>
						<TextBlock Classes="Headline5" Padding="10 0 0 0" Text="授权助手" Foreground="White" FontWeight="Bold"/>
					</StackPanel>
					<TextBlock Classes="Caption" Text="请选择登录类型" Foreground="#E8EAF6" HorizontalAlignment="Center" Margin="0 8 0 0"/>
				</StackPanel>
			</Border>
			
			<!-- 登录类型选择 -->
			<Border Background="#F5F5F5" CornerRadius="8" Padding="16 12" Margin="24 24 24 20">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<RadioButton Content="普通用户" IsChecked="{Binding !IsAdminLogin}" GroupName="LoginType" Margin="0 0 30 0"/>
					<RadioButton Content="超级管理员" IsChecked="{Binding IsAdminLogin}" GroupName="LoginType"/>
				</StackPanel>
			</Border>
			
			<!-- 普通用户登录 -->
			<StackPanel IsVisible="{Binding !IsAdminLogin}" Margin="24 0 24 0">
				<TextBox Classes="filled" AcceptsReturn="False" Height="120"
						 Margin="0 15"
						 Text="{Binding UserLicense}"
						 TextWrapping="Wrap" p1:TextFieldAssist.Label="授权许可证" 
						 UseFloatingWatermark="True" />
				<TextBlock Classes="Caption" Padding="0 0 0 0 " Foreground="Red" Text="输入的许可证无效" 
						   IsVisible="{Binding ShowLoginError}" />
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<controls:FloatingButton Classes="Light Mini"
											 ToolTip.Tip="选择文件"
											 Background="White"
											 Command="{Binding LoginFromFileCommand}"
											 Margin="0 -90 10 0"   >
						<avalonia:MaterialIcon Kind="FileUploadOutline" />
					</controls:FloatingButton>
				</StackPanel>
			</StackPanel>
			
			<!-- 管理员登录 -->
			<StackPanel IsVisible="{Binding IsAdminLogin}" Margin="24 0 24 0">
				<TextBox Margin="0 15"
						 Classes="filled"
						 PasswordChar="●"
						 Text="{Binding AdminPassword}"
						 p1:TextFieldAssist.Label="管理员密码" 
						 UseFloatingWatermark="True" />
				<TextBlock Classes="Caption" Padding="0 0 0 0 " Foreground="Red" Text="密码错误" 
						   IsVisible="{Binding ShowAdminLoginError}" />
			</StackPanel>
			
			
			<Button Content="登录" Foreground="White" 
					Command="{Binding LoginCommand}"
					Background="#3F51B5"
					CornerRadius="8" 
					Height="40"
					Margin="24 24 24 16"  />
		</StackPanel>

	</DockPanel>
</UserControl>
