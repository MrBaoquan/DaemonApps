<Application x:Class="DaemonKit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:reactiveui="http://reactiveui.net"
             xmlns:local="clr-namespace:DaemonKit"
             xmlns:converters="clr-namespace:DaemonKit.Converters"
             xmlns:System="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnMainWindowClose"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Indigo"
                                             SecondaryColor="Lime"/>
                <!-- MaterialDesign 5.x 必须添加此资源字典 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Override MaterialDesign default font with Microsoft YaHei (微软雅黑) -->
            <FontFamily x:Key="MaterialDesignFont">Microsoft YaHei</FontFamily>

            <!-- Converters -->
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
            <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
