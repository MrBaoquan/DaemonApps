<Window x:Class="DaemonKit.PowerSaving.PowerSavingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:DaemonKit.Converters"
        xmlns:power="clr-namespace:DaemonKit.PowerSaving"
        mc:Ignorable="d"
        Title="节能模式控制"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <conv:BooleanInverterConverter x:Key="InverseBooleanConverter"/>
        <conv:StringEqualityConverter x:Key="StringEqualityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:ProtocolToDisplayNameConverter x:Key="ProtocolToDisplayName"/>
        <conv:ProtocolToDescriptionConverter x:Key="ProtocolToDescription"/>

        <Style TargetType="Border"
               x:Key="CardStyle">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E0E0E0"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="20"/>
            <Setter Property="Margin"
                    Value="12"/>
        </Style>

        <Style TargetType="TextBlock"
               x:Key="SectionTitleStyle">
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#212121"/>
            <Setter Property="Margin"
                    Value="0 0 0 16"/>
        </Style>

        <Style TargetType="TextBlock"
               x:Key="LabelStyle">
            <Setter Property="Foreground"
                    Value="#666"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style TargetType="Separator"
               x:Key="SeparatorStyle">
            <Setter Property="Background"
                    Value="#E0E0E0"/>
            <Setter Property="Margin"
                    Value="0 8 0 8"/>
            <Setter Property="Height"
                    Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0 0 0 1"
                Padding="20 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="显示器能源管理"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="智能调节显示器亮度，优化能耗"
                               FontSize="11"
                               Foreground="#888"
                               Margin="0 4 0 0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16 0 0 0">
                    <TextBlock Text="状态: "
                               Foreground="#999"
                               FontSize="11"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#2196F3"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24">
            <StackPanel>

                <!-- 电源模式选择卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="电源模式选择"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- 模式切换按钮（并排显示） -->
                        <UniformGrid Columns="2"
                                     HorizontalAlignment="Stretch"
                                     Margin="0 0 0 16">
                            <!-- 正常模式 -->
                            <Button Height="100"
                                    Margin="0 0 8 0"
                                    Padding="0"
                                    x:Name="NormalModeButton"
                                    Click="NormalModeButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"
                                                Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush"
                                                Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness"
                                                Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Text="💡"
                                                                       FontSize="32"
                                                                       TextAlignment="Center"
                                                                       Margin="0 0 0 8"/>
                                                            <TextBlock Text="正常模式"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#333"
                                                                       TextAlignment="Center"/>
                                                            <TextBlock Text="标准亮度"
                                                                       FontSize="11"
                                                                       Foreground="#999"
                                                                       TextAlignment="Center"
                                                                       Margin="0 4 0 0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPowerSavingMode}"
                                                         Value="False">
                                                <Setter Property="Background"
                                                        Value="#E3F2FD"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#2196F3"/>
                                                <Setter Property="BorderThickness"
                                                        Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 省电模式 -->
                            <Button Height="100"
                                    Margin="8 0 0 0"
                                    Padding="0"
                                    x:Name="PowerSavingModeButton"
                                    Click="PowerSavingModeButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"
                                                Value="#F5F5F5"/>
                                        <Setter Property="BorderBrush"
                                                Value="#E0E0E0"/>
                                        <Setter Property="BorderThickness"
                                                Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="8">
                                                        <StackPanel VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                            <TextBlock Text="🌿"
                                                                       FontSize="32"
                                                                       TextAlignment="Center"
                                                                       Margin="0 0 0 8"/>
                                                            <TextBlock Text="省电模式"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#2E7D32"
                                                                       TextAlignment="Center"/>
                                                            <TextBlock Text="低亮度节能"
                                                                       FontSize="11"
                                                                       Foreground="#558B2F"
                                                                       TextAlignment="Center"
                                                                       Margin="0 4 0 0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPowerSavingMode}"
                                                         Value="True">
                                                <Setter Property="Background"
                                                        Value="#E8F5E9"/>
                                                <Setter Property="BorderBrush"
                                                        Value="#4CAF50"/>
                                                <Setter Property="BorderThickness"
                                                        Value="3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <Separator Style="{StaticResource SeparatorStyle}"/>

                        <!-- 快速操作按钮 -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="🔄 刷新显示器"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="重新扫描和初始化所有显示器"
                                    Margin="0 0 8 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 默认亮度设置卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="亮度控制"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- 正常模式亮度 -->
                        <Grid Margin="0 0 0 16">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPowerSavingMode}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0 0 16 0">
                                <TextBlock Text="💡"
                                           FontSize="20"
                                           Margin="0 0 8 0"/>
                                <TextBlock Text="正常模式亮度"
                                           Style="{StaticResource LabelStyle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <Slider Grid.Column="1"
                                    Minimum="10"
                                    Maximum="100"
                                    Margin="12 0"
                                    Value="{Binding DefaultNormalBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="5"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DefaultNormalBrightness, StringFormat={}{0}%}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontWeight="Bold"
                                       Foreground="#2196F3"
                                       FontSize="14"/>
                        </Grid>

                        <!-- 省电模式亮度 -->
                        <StackPanel Margin="0 0 0 12">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPowerSavingMode}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0 0 16 0">
                                    <TextBlock Text="🌿"
                                               FontSize="20"
                                               Margin="0 0 8 0"/>
                                    <TextBlock Text="省电模式亮度"
                                               Style="{StaticResource LabelStyle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <Slider Grid.Column="1"
                                        Minimum="10"
                                        Maximum="{Binding DefaultNormalBrightness}"
                                        Margin="12 0"
                                        Value="{Binding DefaultPowerSavingBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="5"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DefaultPowerSavingBrightness, StringFormat={}{0}%}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"
                                           FontSize="14"/>
                            </Grid>
                        </StackPanel>

                        <Border Background="#FFF9C4"
                                BorderBrush="#FBC02D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12 8"
                                Margin="0 8 0 0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️"
                                           FontSize="14"
                                           Margin="0 0 8 0"
                                           VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="滑块调整后会立即同步到所有显示器"
                                         FontSize="11"
                                         Foreground="#F57F17"/>
                                    <Run Text="（单独配置的显示器除外）"
                                         FontSize="10"
                                         Foreground="#F9A825"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 未来功能扩展区域 -->
                        <StackPanel Margin="0 16 0 0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPowerSavingMode}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Separator Style="{StaticResource SeparatorStyle}"
                                       Margin="0 0 0 12"/>
                            <TextBlock Text="其他省电设置"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#666"
                                       Margin="0 0 0 8"/>
                            <TextBlock Text="⚠️ 更多省电功能即将推出..."
                                       FontSize="11"
                                       Foreground="#999"
                                       FontStyle="Italic"/>
                            <!-- 这里可以添加：
                                 - 自动关闭显示器
                                 - 定时切换模式
                                 - 根据环境光线调节
                                 - 等等
                            -->
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 显示器控制卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0 0 0 16">
                            <TextBlock Text="显示器控制"
                                       Style="{StaticResource SectionTitleStyle}"
                                       DockPanel.Dock="Left"
                                       Margin="0"/>
                            <TextBlock Text="{Binding Displays.Count, StringFormat={}已连接 {0} 个显示器}"
                                       Foreground="#666"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"/>
                        </DockPanel>

                        <!-- 显示器列表 -->
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type power:DisplayControlItem}">
                                    <Border Margin="0 0 0 12"
                                            Padding="14"
                                            Background="#FAFAFA"
                                            BorderBrush="#E8E8E8"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <StackPanel>
                                            <!-- 显示器头部 -->
                                            <DockPanel Margin="0 0 0 12">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Left">
                                                    <TextBlock Text="🖥️"
                                                               FontSize="18"
                                                               Margin="0 0 8 0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayLabel}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"/>
                                                        <TextBlock Text="{Binding DisplaySubLabel}"
                                                                   Foreground="#999"
                                                                   FontSize="10"
                                                                   Margin="0 2 0 0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Right">
                                                    <materialDesign:PackIcon Kind="CheckCircle"
                                                                             Foreground="#4CAF50"
                                                                             Margin="0 0 6 0"
                                                                             ToolTip="已连接"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- 协议配置区域 -->
                                            <Border Background="#F5F5F5"
                                                    BorderBrush="#DDD"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10"
                                                    Margin="0 0 0 12">
                                                <StackPanel>
                                                    <TextBlock Text="通信协议配置"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#666"
                                                               Margin="0 0 0 8"/>

                                                    <!-- 协议选择 -->
                                                    <Grid Margin="0 0 0 8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="通信协议:"
                                                                   Style="{StaticResource LabelStyle}"/>
                                                        <ComboBox Grid.Column="1"
                                                                  SelectedItem="{Binding SelectedProtocol, Mode=TwoWay}"
                                                                  FontSize="11"
                                                                  ToolTip="选择设备使用的通信协议类型">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Converter={StaticResource ProtocolToDisplayName}}"
                                                                                   FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Converter={StaticResource ProtocolToDescription}}"
                                                                                   FontSize="9"
                                                                                   Foreground="#999"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                            <ComboBox.Items>
                                                                <power:ProtocolType>Auto</power:ProtocolType>
                                                                <power:ProtocolType>DdcCi</power:ProtocolType>
                                                                <power:ProtocolType>KSV_Serial</power:ProtocolType>
                                                                <power:ProtocolType>KSV_Tcp</power:ProtocolType>
                                                            </ComboBox.Items>
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- KSV 设备说明 -->
                                                    <Border Background="#FFF9E6"
                                                            BorderBrush="#FFE082"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="8 6"
                                                            Margin="0 0 0 8"
                                                            Visibility="{Binding IsKsvDevice, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="⚙️ KSV 控制器配置"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#F57C00"
                                                                       Margin="0 0 0 4"/>
                                                            <TextBlock FontSize="9"
                                                                       Foreground="#666"
                                                                       TextWrapping="Wrap">
                                                                <Run Text="KSV KM2/KM4 LED控制器支持串口和网口两种通信方式。"/>
                                                                <LineBreak/>
                                                                <Run Text="• 串口模式: RS232 (默认115200bps 8N1)"/>
                                                                <LineBreak/>
                                                                <Run Text="• 网口模式: TCP (默认端口18100)"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 串口参数(仅KSV_Serial可见) -->
                                                    <StackPanel Visibility="{Binding IsSerialLed, Converter={StaticResource BoolToVis}}"
                                                                Margin="0 4 0 0">
                                                        <Grid Margin="0 0 0 4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="串口号:"
                                                                       Style="{StaticResource LabelStyle}"/>
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AvailableSerialPorts}"
                                                                      SelectedItem="{Binding SerialPort, Mode=TwoWay}"
                                                                      FontSize="11"
                                                                      ToolTip="从列表中选择可用的串口"/>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="波特率:"
                                                                       Style="{StaticResource LabelStyle}"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding SerialBaudRate, Mode=TwoWay}"
                                                                     FontSize="11"
                                                                     ToolTip="默认: 115200bps"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- 网口参数(仅KSV_Tcp可见) -->
                                                    <StackPanel Visibility="{Binding IsTcpLed, Converter={StaticResource BoolToVis}}"
                                                                Margin="0 4 0 0">
                                                        <Grid Margin="0 0 0 4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="IP 地址:"
                                                                       Style="{StaticResource LabelStyle}"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding TcpAddress, Mode=TwoWay}"
                                                                     FontSize="11"
                                                                     ToolTip="控制器的IP地址,如: 192.168.1.100"/>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="端口号:"
                                                                       Style="{StaticResource LabelStyle}"/>
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding TcpPort, Mode=TwoWay}"
                                                                     FontSize="11"
                                                                     ToolTip="KSV 默认: 18100"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- 连接测试 -->
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0 8 0 0">
                                                        <Border Padding="8 4"
                                                                Margin="0 0 8 0"
                                                                CornerRadius="6"
                                                                Background="#F7F7F7"
                                                                BorderBrush="#E0E0E0"
                                                                BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Width="14"
                                                                                         Height="14">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Setter Property="Kind"
                                                                                    Value="LanPending"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#9E9E9E"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnecting}"
                                                                                             Value="True">
                                                                                    <Setter Property="Kind"
                                                                                            Value="ProgressClock"/>
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#2196F3"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsConnected}"
                                                                                             Value="True">
                                                                                    <Setter Property="Kind"
                                                                                            Value="LanConnect"/>
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#4CAF50"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                                <TextBlock Text="{Binding ConnectionStatus}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Margin="6 0 0 0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground"
                                                                                    Value="#9E9E9E"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnecting}"
                                                                                             Value="True">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#2196F3"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsConnected}"
                                                                                             Value="True">
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#4CAF50"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                        <Button Height="30"
                                                                Padding="12 0"
                                                                Command="{Binding TestConnectionCommand}"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                                IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBooleanConverter}}">
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Width="14"
                                                                                         Height="14">
                                                                    <materialDesign:PackIcon.Style>
                                                                        <Style TargetType="materialDesign:PackIcon">
                                                                            <Setter Property="Kind"
                                                                                    Value="LanCheck"/>
                                                                            <Setter Property="Foreground"
                                                                                    Value="#2196F3"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnecting}"
                                                                                             Value="True">
                                                                                    <Setter Property="Kind"
                                                                                            Value="ProgressClock"/>
                                                                                    <Setter Property="Foreground"
                                                                                            Value="#2196F3"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </materialDesign:PackIcon.Style>
                                                                </materialDesign:PackIcon>
                                                                <TextBlock FontSize="12"
                                                                           VerticalAlignment="Center"
                                                                           Margin="6 0 0 0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text"
                                                                                    Value="测试连接"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsConnecting}"
                                                                                             Value="True">
                                                                                    <Setter Property="Text"
                                                                                            Value="连接中..."/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 亮度调节滑块 (仅在启用单独控制时显示) -->
                                            <Grid Margin="0 0 0 12"
                                                  Visibility="{Binding OverrideEnabled, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="亮度:"
                                                           Style="{StaticResource LabelStyle}"/>
                                                <Slider Grid.Column="1"
                                                        Margin="8 0"
                                                        VerticalAlignment="Center"
                                                        Minimum="{Binding Minimum}"
                                                        Maximum="{Binding Maximum}"
                                                        Value="{Binding TargetBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TargetBrightness, StringFormat={}{0}%}"
                                                           TextAlignment="Right"
                                                           FontWeight="Bold"
                                                           Foreground="#2196F3"
                                                           FontSize="12"/>
                                            </Grid>

                                            <!-- 单独设置复选框 -->
                                            <CheckBox Content="为此显示器单独配置（省电模式下使用自定义亮度）"
                                                      IsChecked="{Binding OverrideEnabled, Mode=TwoWay}"
                                                      FontSize="11"
                                                      Foreground="#333"
                                                      Padding="4 0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 无显示器提示 -->
                        <TextBlock Text="未找到支持DDC/CI协议的显示器，请确保显示器已连接并在BIOS中启用DDC/CI功能"
                                   Foreground="#F57C00"
                                   FontSize="11"
                                   Margin="0 8 0 0"
                                   Visibility="{Binding Displays.Count, Converter={StaticResource InverseBooleanConverter}, FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>