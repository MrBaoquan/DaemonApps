<reactiveui:ReactiveWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DaemonKit"
    xmlns:reactiveui="http://reactiveui.net"
    x:Class="DaemonKit.ProcessNodeForm"
    x:TypeArguments="local:PNFViewModel"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="{Binding Title}"
    Height="630"
    Width="620"
    MinHeight="630"
    MinWidth="620">

    <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
            Padding="25,20,25,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- 基本信息分组 -->
                <TextBlock Text="基本信息"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,5,0,20"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                <materialDesign:Card Padding="20,18,20,20"
                                     Margin="0,0,0,25"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 第一行：进程路径 -->
                        <TextBox Grid.Row="0"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 FontSize="15"
                                 materialDesign:HintAssist.Hint="进程路径"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Path}"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <MouseBinding Command="{Binding SelectProcess}"
                                              MouseAction="LeftClick"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- 第二行：进程名 + 延迟启动 -->
                        <TextBox Grid.Row="2"
                                 Grid.Column="0"
                                 FontSize="15"
                                 materialDesign:HintAssist.Hint="进程名(友好名称)"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Name}"
                                 VerticalAlignment="Center"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="2"
                                 FontSize="15"
                                 materialDesign:HintAssist.Hint="延迟启动"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Delay}"
                                 VerticalAlignment="Center"
                                 materialDesign:TextFieldAssist.SuffixText="ms"/>

                        <!-- 第三行：启动参数 -->
                        <TextBox Grid.Row="4"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 FontSize="15"
                                 materialDesign:HintAssist.Hint="启动参数"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Arguments}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </materialDesign:Card>

                <!-- 窗口设置分组 -->
                <TextBlock Text="窗口设置"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                <materialDesign:Card Margin="0,0,0,25"
                                     Padding="20,18,20,18"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 窗口位置 -->
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Path=MoveWindow, Mode=TwoWay}"
                                  Content="位置"
                                  VerticalAlignment="Center"
                                  FontWeight="Medium"
                                  FontSize="14"/>

                        <TextBox Grid.Column="2"
                                 IsEnabled="{Binding MoveWindow}"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="X"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding PosX}"
                                 VerticalAlignment="Center"/>

                        <TextBox Grid.Column="4"
                                 IsEnabled="{Binding MoveWindow}"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="Y"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding PosY}"
                                 VerticalAlignment="Center"/>

                        <!-- 窗口大小 -->
                        <CheckBox Grid.Column="6"
                                  IsChecked="{Binding Path=ResizeWindow, Mode=TwoWay}"
                                  Content="大小"
                                  VerticalAlignment="Center"
                                  FontWeight="Medium"
                                  FontSize="14"/>

                        <TextBox Grid.Column="8"
                                 IsEnabled="{Binding ResizeWindow}"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="宽"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Width}"
                                 VerticalAlignment="Center"/>

                        <TextBox Grid.Column="10"
                                 IsEnabled="{Binding ResizeWindow}"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="高"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Text="{Binding Height}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </materialDesign:Card>

                <!-- 运行选项分组 -->
                <TextBlock Text="运行选项"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                <materialDesign:Card Margin="0,0,0,30"
                                     Padding="20,16,20,16"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding Path=KeepTop, Mode=TwoWay}"
                                  Content="置顶窗口"
                                  VerticalAlignment="Center"
                                  FontSize="14"/>

                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding Path=MinimizedStartUp, Mode=TwoWay}"
                                  Content="隐藏窗口"
                                  VerticalAlignment="Center"
                                  FontSize="14"/>

                        <CheckBox Grid.Column="2"
                                  IsChecked="{Binding Path=RunAs, Mode=TwoWay}"
                                  Content="管理员运行"
                                  VerticalAlignment="Center"
                                  FontSize="14"/>

                        <CheckBox Grid.Column="3"
                                  IsChecked="{Binding Path=NoDaemon, Mode=TwoWay}"
                                  Content="仅启动不守护"
                                  VerticalAlignment="Center"
                                  FontSize="14"/>
                    </Grid>
                </materialDesign:Card>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0">
                    <Button Margin="12,0"
                            Width="130"
                            Height="38"
                            Content="确认"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding Confirm}"/>
                    <Button Margin="12,0"
                            Width="130"
                            Height="38"
                            Content="取消"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding Cancel}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</reactiveui:ReactiveWindow>
