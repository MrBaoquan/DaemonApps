<reactiveui:ReactiveWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:local="clr-namespace:DaemonKit"
                           xmlns:core="clr-namespace:DaemonKit.Core"
                           xmlns:converters="clr-namespace:DaemonKit.Converters"
                           xmlns:reactiveui="http://reactiveui.net"
                           x:Class="DaemonKit.Schedule"
                           x:TypeArguments="local:ScheduleViewModel"
                           xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                           mc:Ignorable="d"
                           Title="计划任务"
                           Height="500"
                           Width="900"
                           Background="#FAFAFA"
                           WindowStyle="None"
                           AllowsTransparency="True"
                           ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:ScheduleTaskTypeToStringConverter x:Key="ScheduleTaskTypeToStringConverter"/>
        <converters:ScheduleTriggerTypeToStringConverter x:Key="ScheduleTriggerTypeToStringConverter"/>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="12"
            Margin="8"
            materialDesign:ElevationAssist.Elevation="Dp4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                    CornerRadius="12,12,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⏰ 计划任务管理"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="MinimizeButton_Click"
                                Foreground="White"
                                ToolTip="最小化">
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     Width="18"
                                                     Height="18"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="4,0,0,0"
                                Click="CloseButton_Click"
                                Foreground="White"
                                ToolTip="关闭">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="18"
                                                     Height="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 数据网格 -->
            <materialDesign:Card Grid.Row="1"
                                 Margin="16,12,16,12"
                                 UniformCornerRadius="8"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <DataGrid ItemsSource="{Binding ScheduleItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="All"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F8F8"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          VerticalGridLinesBrush="Transparent"
                          FontSize="12"
                          RowHeight="48"
                          Padding="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="FontSize"
                                    Value="12"/>
                            <Setter Property="FontWeight"
                                    Value="Medium"/>
                            <Setter Property="Foreground"
                                    Value="#424242"/>
                            <Setter Property="Background"
                                    Value="#F5F5F5"/>
                            <Setter Property="Height"
                                    Value="44"/>
                            <Setter Property="Padding"
                                    Value="16,0"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                            <Setter Property="Padding"
                                    Value="16,0"/>
                            <Setter Property="Foreground"
                                    Value="#616161"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <materialDesign:DataGridComboBoxColumn Header="任务类型"
                                                               Width="120"
                                                               ItemsSourceBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}, Path=DataContext.TaskTypes}"
                                                               SelectedValueBinding="{Binding TaskType, Converter={StaticResource ScheduleTaskTypeToStringConverter}}">
                            <materialDesign:DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource MaterialDesignComboBox}">
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                </Style>
                            </materialDesign:DataGridComboBoxColumn.ElementStyle>
                            <materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource MaterialDesignComboBox}">
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                </Style>
                            </materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                        </materialDesign:DataGridComboBoxColumn>

                        <materialDesign:DataGridComboBoxColumn Header="触发器"
                                                               Width="150"
                                                               ItemsSourceBinding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}, Path=DataContext.TaskTriggerTypes}"
                                                               SelectedValueBinding="{Binding Trigger, Converter={StaticResource ScheduleTriggerTypeToStringConverter}}">
                            <materialDesign:DataGridComboBoxColumn.ElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource MaterialDesignComboBox}">
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                </Style>
                            </materialDesign:DataGridComboBoxColumn.ElementStyle>
                            <materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                                <Style TargetType="ComboBox"
                                       BasedOn="{StaticResource MaterialDesignComboBox}">
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                </Style>
                            </materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                        </materialDesign:DataGridComboBoxColumn>

                        <DataGridTemplateColumn Header="时间"
                                Width="*">
                            <!-- 编辑模板:根据触发器类型显示不同的编辑控件 -->
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- 每天触发器：时间选择器 -->
                                        <materialDesign:DialogHost CloseOnClickAway="False"
                                                IsOpen="True">
                                            <materialDesign:DialogHost.Style>
                                                <Style TargetType="materialDesign:DialogHost">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trigger}"
                                                                Value="{x:Static core:TriggerType.Daily}">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:DialogHost.Style>
                                            <materialDesign:DialogHost.DialogContent>
                                                <Border Background="White"
                                                        CornerRadius="12"
                                                        Padding="24"
                                                        materialDesign:ElevationAssist.Elevation="Dp4">
                                                    <StackPanel>
                                                        <TextBlock Text="选择执行时间"
                                                                   FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="#424242"
                                                                   Margin="0,0,0,16"/>
                                                        <materialDesign:Clock Is24Hours="True"
                                                                              Time="{Binding Time}"
                                                                              DisplayAutomation="ToSeconds"/>
                                                        <Button Margin="0,20,0,0"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                                                Content="确认"
                                                                FontSize="12"
                                                                Padding="16,6"/>
                                                    </StackPanel>
                                                </Border>
                                            </materialDesign:DialogHost.DialogContent>
                                            <TextBlock/>
                                        </materialDesign:DialogHost>

                                        <!-- 程序启动后触发器：秒数输入框 -->
                                        <TextBox VerticalAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox"
                                                        BasedOn="{StaticResource MaterialDesignTextBox}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trigger}"
                                                                Value="{x:Static core:TriggerType.OnAppStart}">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Trigger}"
                                                                Value="{x:Static core:TriggerType.OnAppStartOnce}">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                            <!-- 显示模板：双击进入编辑状态 -->
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeString}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#616161"
                                               Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 任务执行状态 -->
                        <DataGridTemplateColumn Header="状态"
                                Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Width="18"
                                                Height="18">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="VerticalAlignment"
                                                            Value="Center"/>
                                                    <Setter Property="Kind"
                                                            Value="TimerCancelOutline"/>
                                                    <Setter Property="Foreground"
                                                            Value="#BDBDBD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                Value="0">
                                                            <Setter Property="Kind"
                                                                    Value="TimerCancelOutline"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#BDBDBD"/>
                                                            <Setter Property="ToolTip"
                                                                    Value="任务过期"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                Value="1">
                                                            <Setter Property="Kind"
                                                                    Value="TimerSettingsOutline"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#4CAF50"/>
                                                            <Setter Property="ToolTip"
                                                                    Value="等待执行"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}"
                                                                Value="2">
                                                            <Setter Property="Kind"
                                                                    Value="TimerCheckOutline"/>
                                                            <Setter Property="Foreground"
                                                                    Value="#2196F3"/>
                                                            <Setter Property="ToolTip"
                                                                    Value="执行完成"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="操作"
                                Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                      ToolTip="启用/禁用任务"
                                                      Margin="0,0,12,0"/>
                                        <Button ToolTip="删除该任务"
                                                Command="{Binding DeleteCommand}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Width="32"
                                                Height="32"
                                                Padding="0">
                                            <materialDesign:PackIcon Kind="Delete"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="#F44336"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    Background="#FAFAFA"
                    CornerRadius="0,0,12,12"
                    Padding="16,12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#EEEEEE">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="40"
                            Height="40"
                            ToolTip="按时间排序"
                            Command="{Binding SortByTimeCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="SortClockAscendingOutline"
                                                 Width="20"
                                                 Height="20"/>
                    </Button>
                    <Button Width="40"
                            Height="40"
                            ToolTip="添加任务"
                            Command="{Binding AddScheduleCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Add"
                                                 Width="20"
                                                 Height="20"/>
                    </Button>
                    <Button Width="90"
                            Height="40"
                            ToolTip="保存任务"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="保存"
                            FontSize="12"
                            materialDesign:ElevationAssist.Elevation="Dp2">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius"
                                        Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</reactiveui:ReactiveWindow>
