<Window x:Class="DaemonKit.ScreenshotEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图编辑器"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <DockPanel>
        <!-- 工具栏 -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 画笔工具 -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Text="画笔："
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="BrushSizeCombo"
                              Width="80"
                              SelectedIndex="2"
                              Margin="0,0,10,0">
                        <ComboBoxItem Content="2px"/>
                        <ComboBoxItem Content="4px"/>
                        <ComboBoxItem Content="6px"/>
                        <ComboBoxItem Content="8px"/>
                        <ComboBoxItem Content="10px"/>
                    </ComboBox>
                </StackPanel>

                <!-- 颜色选择 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <TextBlock Text="颜色："
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="ColorPickerButton"
                            Width="40"
                            Height="30"
                            Background="Red"
                            Click="ColorPickerButton_Click"/>
                </StackPanel>

                <!-- 清空按钮 -->
                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Content="清空"
                        Padding="15,6"
                        Margin="0,0,10,0"
                        Click="ClearButton_Click"/>

                <!-- 分隔符 -->
                <Separator Grid.Column="3"
                        Margin="10,0"/>

                <!-- 保存/取消按钮 -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="SaveButton"
                            Content="保存"
                            Background="#00A0FF"
                            Foreground="White"
                            Padding="15,6"
                            Margin="0,0,8,0"
                            Click="SaveButton_Click"/>
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Background="#666666"
                            Foreground="White"
                            Padding="15,6"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 画布区域 -->
        <Border DockPanel.Dock="Bottom"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="5">
            <Grid>
                <Image x:Name="BackgroundImage"
                       Stretch="Uniform"/>
                <Canvas x:Name="DrawingCanvas"
                        Background="Transparent"
                        MouseDown="DrawingCanvas_MouseDown"
                        MouseMove="DrawingCanvas_MouseMove"
                        MouseUp="DrawingCanvas_MouseUp"/>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="10">
            <TextBlock x:Name="StatusText"
                       Text="准备就绪"
                       Foreground="#666666"
                       FontSize="12"/>
        </Border>
    </DockPanel>
</Window>
