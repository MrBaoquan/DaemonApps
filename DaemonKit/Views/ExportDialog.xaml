<Window x:Class="DaemonKit.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:DaemonKit.Converters"
        Title="打包软件包"
        Height="600"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <conv:BooleanInverterConverter x:Key="InverseBooleanConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 进度面板 -->
            <RowDefinition Height="*"/>
            <!-- 主内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 进度面板（顶部固定） -->
        <Border Grid.Row="0"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1"
                Padding="20,15"
                Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="Medium"
                               Margin="0,0,0,8"/>
                    <ProgressBar Value="{Binding ProgressPercentage}"
                                 Maximum="100"
                                 Height="8"
                                 Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ProgressPercentage, StringFormat={}{0:F1}%}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentFile}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding CurrentFile}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="取消"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding CancelExportCommand}"
                            ToolTip="取消打包操作"
                            Margin="0,0,5,0"/>
                    <Button Content="最小化"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding MinimizeCommand}"
                            ToolTip="最小化到状态栏，在主窗口查看进度"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区（可滚动） -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,20,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="打包软件包"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           Margin="0,0,0,20"
                           Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <!-- 打包摘要（打包过程中显示） -->
                <GroupBox Grid.Row="0"
                          Header="打包摘要"
                          Style="{StaticResource MaterialDesignCardGroupBox}"
                          Margin="0,0,0,15"
                          Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="10">
                        <TextBlock Margin="0,5,0,10">
                            <Run Text="包含内容："
                                 FontWeight="Medium"/>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2"
                                    Visibility="{Binding IncludeConfigs, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Check"
                                                     Width="16"
                                                     Height="16"
                                                     Foreground="Green"
                                                     Margin="0,0,5,0"/>
                            <TextBlock Text="运行配置"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2"
                                    Visibility="{Binding IncludePrograms, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Check"
                                                     Width="16"
                                                     Height="16"
                                                     Foreground="Green"
                                                     Margin="0,0,5,0"/>
                            <StackPanel>
                                <TextBlock Text="应用程序文件"/>
                                <TextBlock Text="{Binding SelectedNodesText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,10"/>

                        <TextBlock Text="正在打包，请稍候..."
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 导出内容选择 -->
                <GroupBox Grid.Row="1"
                          Header="打包内容"
                          Style="{StaticResource MaterialDesignCardGroupBox}"
                          Margin="0,0,0,15"
                          IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <StackPanel Margin="10">
                        <CheckBox Content="运行配置（任务计划、快捷键、全局设置）"
                                  IsChecked="{Binding IncludeConfigs}"
                                  Margin="0,5"/>
                        <TextBlock Text="   包含任务调度规则、快捷键绑定等运行环境配置"
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,0,0,10"/>
                        <CheckBox Content="应用程序文件"
                                  IsChecked="{Binding IncludePrograms}"
                                  Margin="0,5"/>
                        <TextBlock Text="   包含可执行文件和依赖项，确保在其他电脑上可以直接运行"
                                   FontSize="11"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,0,0,10"/>

                        <!-- 进程树选择（在勾选应用程序文件后显示） -->
                        <StackPanel Visibility="{Binding IncludePrograms, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="选择要打包的应用程序："
                                       FontWeight="Medium"
                                       Margin="0,0,0,5"/>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    MaxHeight="250"
                                    Margin="0,0,0,5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TreeView x:Name="ProcessTreeView"
                                              ItemsSource="{Binding ProcessTree}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Margin="5">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem"
                                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded"
                                                        Value="True"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Margin="0,0,5,0"/>
                                                    <materialDesign:PackIcon Kind="Application"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding MetaData.Name}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,0">
                                <Button Content="全选"
                                        Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,0,5,0"/>
                                <Button Content="清空"
                                        Command="{Binding ClearSelectionCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 说明（保留核心功能） -->
                <GroupBox Grid.Row="2"
                          Header="包说明（可选）"
                          Style="{StaticResource MaterialDesignCardGroupBox}"
                          Margin="0,0,0,0"
                          IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Margin="10"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             materialDesign:HintAssist.Hint="输入对此配置包的描述..."/>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- 底部按钮区域（固定显示） -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource MaterialDesignPaper}"
                Padding="20,15">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <Button Content="开始打包"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Width="100"
                        Margin="0,0,10,0"/>
                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
