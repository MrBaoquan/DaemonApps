<reactiveui:ReactiveWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:local="clr-namespace:DaemonKit"
                           xmlns:core="clr-namespace:DaemonKit.Core"
                           xmlns:models="clr-namespace:DaemonKit.Models"
                           xmlns:System="clr-namespace:System;assembly=System.Runtime"
                           xmlns:fa="http://schemas.fontawesome.io/icons/"
                           xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                           TextElement.FontWeight="Regular"
                           TextElement.FontSize="13"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Auto"
                           FontFamily="{DynamicResource MaterialDesignFont}"
                           xmlns:reactiveui="http://reactiveui.net"
                           xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                           x:Class="DaemonKit.MainWindow"
                           x:TypeArguments="local:MainViewModel"
                           Topmost="True"
                           mc:Ignorable="d"
                           Title="运维管家"
                           Height="600"
                           Width="1000"
                           ResizeMode="CanResizeWithGrip"
                           MinWidth="800"
                           MinHeight="600"
                           WindowStartupLocation="CenterScreen"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           Background="#F5F5F5">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 引入外部样式资源 -->
                <ResourceDictionary Source="../Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="../Styles/VolumeSliderStyle.xaml"/>
                <ResourceDictionary Source="../Styles/TreeViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 音量图标转换器 -->
            <local:VolumeToIconConverter x:Key="VolumeToIconConverter"/>
            <local:VolumeWithMuteToIconConverter x:Key="VolumeWithMuteToIconConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost Name="MainDialog"
                               CloseOnClickAway="True">
        <DockPanel>
            <!-- 托盘图标 -->
            <tb:TaskbarIcon NoLeftClickDelay="True"
                            LeftClickCommand="{Binding ShowWindow}"
                            DoubleClickCommand="{Binding ShowWindow}"
                            IconSource="/Resources/logo.ico"
                            ToolTipText="运维管家持续守护中...">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu FontFamily="{DynamicResource MaterialDesignFont}">
                        <MenuItem Header="打开面板"
                                  Command="{Binding ShowWindow}">
                            <MenuItem.Icon>
                                <Image Width="16"
                                       Height="16"
                                       Source="/Resources/Icons/show-panel.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="屏幕截图"
                                  Command="{Binding TakeScreenshot}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Camera"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="拾取屏幕颜色"
                                  Command="{Binding PickColor}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Eyedropper"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="打开截图文件夹"
                                  Click="OpenScreenshotFolder_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FolderImage"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="设置"
                                  Command="{Binding OpenSettings}">
                            <MenuItem.Icon>
                                <Image Width="16"
                                       Height="16"
                                       Source="/Resources/Icons/settings.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="退出"
                                  Command="{Binding Quit}">
                            <MenuItem.Icon>
                                <Image Width="16"
                                       Height="16"
                                       Source="/Resources/Icons/quit.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Menu Grid.Row="0"
                          Grid.Column="0"
                          x:Name="MainMenu"
                          IsMainMenu="True"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8,0"
                          FontFamily="{DynamicResource MaterialDesignFont}">
                        <MenuItem Header="_文件">
                            <MenuItem Header="进程目录"
                                      InputGestureText="Ctrl+1"
                                      Icon="{materialDesign:PackIcon Kind=FolderOpenOutline}"
                                      Command="{Binding RunProcess}"
                                      CommandParameter="{Binding OpenAppRoot_args}"/>
                            <MenuItem Header="资源管理器"
                                      InputGestureText="Ctrl+2"
                                      Icon="{materialDesign:PackIcon Kind=FolderSearchOutline}"
                                      Command="{Binding RunProcess}"
                                      CommandParameter="{Binding OpenFileExplorer_args}"/>
                            <MenuItem Header="截图文件夹"
                                      Icon="{materialDesign:PackIcon Kind=FolderImage}"
                                      Click="OpenScreenshotFolder_Click"/>
                            <Separator/>
                            <MenuItem Header="导出软件包"
                                      Icon="{materialDesign:PackIcon Kind=Export}"
                                      Click="ExportConfig_Click"/>
                            <MenuItem Header="导入软件包"
                                      Icon="{materialDesign:PackIcon Kind=Import}"
                                      Click="ImportConfig_Click"/>
                            <Separator/>
                            <MenuItem Header="备份管理"
                                      Icon="{materialDesign:PackIcon Kind=FolderClock}"
                                      Click="OpenBackupManager_Click"/>
                            <Separator/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=Settings}"
                                      Header="设置"
                                      Command="{Binding OpenSettings}"/>
                            <Separator/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=ExitToApp}"
                                      Header="退出"
                                      Command="{Binding Quit}"/>
                        </MenuItem>
                        <MenuItem Header="_功能">
                            <MenuItem Icon="{materialDesign:PackIcon Kind=Camera}"
                                      Header="屏幕截图"
                                      InputGestureText="Alt+X"
                                      Command="{Binding TakeScreenshot}"/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=Eyedropper}"
                                      Header="拾取屏幕颜色"
                                      InputGestureText="Alt+C"
                                      Command="{Binding PickColor}"/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=Leaf}"
                                      Header="节能模式"
                                      Command="{Binding OpenPowerSavingPanel}"/>
                            <Separator/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=RemoteDesktop}"
                                      Header="联调面板"
                                      Command="{Binding OpenRemotePanel}"/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=SwapVertical}"
                                      Header="文件传输"
                                      Command="{Binding OpenTransferList}"/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=PackageVariantClosed}"
                                      Header="资源库"
                                      Command="{Binding OpenResourceLibrary}"/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=ClockOutline}"
                                      Header="计划任务"
                                      Command="{Binding OpenScheduleWindow}"/>
                            <Separator/>
                            <MenuItem Icon="{materialDesign:PackIcon Kind=KeyboardSettings}"
                                      Header="快捷键设置"
                                      Click="OpenHotkeySettings_Click"/>
                        </MenuItem>
                        <MenuItem Header="_帮助">
                            <MenuItem Header="快捷键说明"
                                      Icon="{materialDesign:PackIcon Kind=Help}"
                                      Command="{x:Static materialDesign:DialogHost.OpenDialogCommand}">
                                <MenuItem.CommandParameter>
                                    <StackPanel Margin="30">
                                        <TextBlock Text="Ctrl + W           终止进程树"
                                                   Padding="0 5 0 5"/>
                                        <TextBlock Text="Ctrl + R           启动进程树"
                                                   Padding="0 5 0 5"/>
                                        <TextBlock Text="Ctrl + D           [显示/隐藏]窗口"
                                                   Padding="0 5 0 5"/>
                                        <TextBlock Text="Ctrl + Shift + W   关闭桌面进程"
                                                   Padding="0 5 0 5"/>
                                        <TextBlock Text="Ctrl + Shift + E   启用桌面进程"
                                                   Padding="0 5 0 5"/>
                                        <TextBlock Text="Ctrl + Shift + T   切换触摸屏"
                                                   Padding="0 5 0 5"/>
                                    </StackPanel>

                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="版本更新"
                                      Icon="{materialDesign:PackIcon Kind=Update}"
                                      Command="{Binding RunProcess}"
                                      CommandParameter="{Binding OpenUpdatePage_args}"/>
                        </MenuItem>
                    </Menu>
                    <DockPanel Grid.Row="0"
                               Grid.Column="1">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <!-- 音量控制 - 极简风格 -->
                            <materialDesign:PopupBox PlacementMode="BottomAndAlignCentres"
                                                     StaysOpen="True"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="0 0 8 0"
                                                     ToolTip="音量控制"
                                                     ToolTipService.Placement="Bottom">
                                <materialDesign:PopupBox.ToggleContent>
                                    <Border Background="White"
                                            CornerRadius="16"
                                            Padding="4"
                                            materialDesign:ElevationAssist.Elevation="Dp3">
                                        <materialDesign:PackIcon Foreground="#1976D2"
                                                                 Width="22"
                                                                 Height="22">
                                            <materialDesign:PackIcon.Kind>
                                                <MultiBinding Converter="{StaticResource VolumeWithMuteToIconConverter}"
                                                              FallbackValue="VolumeHigh"
                                                              Mode="OneWay">
                                                    <Binding Path="SystemVolume"
                                                             Mode="OneWay"
                                                             UpdateSourceTrigger="PropertyChanged"/>
                                                    <Binding Path="IsMuted"
                                                             Mode="OneWay"
                                                             UpdateSourceTrigger="PropertyChanged"/>
                                                </MultiBinding>
                                            </materialDesign:PackIcon.Kind>
                                        </materialDesign:PackIcon>
                                    </Border>
                                </materialDesign:PopupBox.ToggleContent>
                                <!-- 极简音量面板 -->
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="12"
                                        Width="64"
                                        materialDesign:ElevationAssist.Elevation="Dp4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- 音量百分比 -->
                                        <TextBlock Text="{Binding SystemVolume, StringFormat='{}{0:F0}'}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0 0 0 8"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>

                                        <!-- 垂直滑块 -->
                                        <Slider Value="{Binding SystemVolume, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="100"
                                                Orientation="Vertical"
                                                Height="150"
                                                Width="30"
                                                TickFrequency="25"
                                                IsMoveToPointEnabled="True"
                                                IsSnapToTickEnabled="False"
                                                ToolTip="拖动调节音量"
                                                HorizontalAlignment="Center"
                                                Margin="0 5"
                                                Style="{StaticResource VolumeSliderStyle}"/>

                                        <!-- 音量图标 -->
                                        <Grid Margin="0 8 0 0"
                                              Width="30">
                                            <materialDesign:PackIcon Width="20"
                                                                     Height="20"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                                                <materialDesign:PackIcon.Kind>
                                                    <MultiBinding Converter="{StaticResource VolumeWithMuteToIconConverter}"
                                                                  FallbackValue="VolumeHigh">
                                                        <Binding Path="SystemVolume"/>
                                                        <Binding Path="IsMuted"/>
                                                    </MultiBinding>
                                                </materialDesign:PackIcon.Kind>
                                            </materialDesign:PackIcon>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </materialDesign:PopupBox>

                            <!-- 电源管理 -->
                            <materialDesign:PopupBox HorizontalAlignment="Right"
                                                     IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                                     PlacementMode="BottomAndAlignCentres"
                                                     StaysOpen="True"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="0 0 12 0"
                                                     ToolTip="电源管理"
                                                     ToolTipService.Placement="Bottom">
                                <materialDesign:PopupBox.ToggleContent>
                                    <Border Background="White"
                                            CornerRadius="16"
                                            Padding="4"
                                            materialDesign:ElevationAssist.Elevation="Dp3">
                                        <materialDesign:PackIcon Foreground="#D32F2F"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Opacity="0.8"
                                                                 Kind="Power"/>
                                    </Border>
                                </materialDesign:PopupBox.ToggleContent>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="10"
                                        materialDesign:ElevationAssist.Elevation="Dp4">
                                    <StackPanel Orientation="Vertical">
                                        <Button Style="{StaticResource PowerButtonStyle}"
                                                Command="{Binding ShutdownSystem}"
                                                ToolTip="关闭计算机"
                                                Margin="0 0 0 5">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Power"
                                                                         Width="20"
                                                                         Height="20"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0 0 8 0"/>
                                                <TextBlock Text="关机"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PowerButtonStyle}"
                                                Command="{Binding RestartSystem}"
                                                ToolTip="重启计算机"
                                                Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Restart"
                                                                         Width="20"
                                                                         Height="20"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0 0 8 0"/>
                                                <TextBlock Text="重启"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- 状态栏 - 极简风格 -->
                <Border DockPanel.Dock="Bottom"
                        Height="28"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#F0F0F0"
                        Background="White">
                    <StatusBar x:Name="statusbar"
                               Background="Transparent"
                               VerticalAlignment="Center">

                        <StatusBarItem Margin="4,0,0,0"
                                       ToolTipService.ShowOnDisabled="True">
                            <StatusBarItem.Style>
                                <Style TargetType="StatusBarItem">
                                    <Setter Property="ToolTip"
                                            Value="计划任务已启用"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GlobalSchedule.ScheduleTasksEnabled}"
                                                     Value="False">
                                            <Setter Property="ToolTip"
                                                    Value="计划任务已禁用"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StatusBarItem.Style>
                            <materialDesign:PackIcon Width="16"
                                                     Height="16"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind"
                                                Value="ClockCheckOutline"/>
                                        <Setter Property="Foreground"
                                                Value="#4CAF50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalSchedule.ScheduleTasksEnabled}"
                                                         Value="False">
                                                <Setter Property="Kind"
                                                        Value="ClockAlertOutline"/>
                                                <Setter Property="Foreground"
                                                        Value="#9E9E9E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </StatusBarItem>
                        <StatusBarItem HorizontalAlignment="Left"
                                       Margin="4,0,0,0"
                                       ToolTipService.ShowOnDisabled="True">
                            <!-- 省电模式指示器 -->
                            <materialDesign:PackIcon Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind"
                                                Value="Brightness7"/>
                                        <Setter Property="Foreground"
                                                Value="#4CAF50"/>
                                        <Setter Property="ToolTip"
                                                Value="正常模式"/>
                                        <Setter Property="Opacity"
                                                Value="1.0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PowerSaving.IsPowerSavingMode}"
                                                         Value="True">
                                                <Setter Property="Kind"
                                                        Value="Brightness4"/>
                                                <Setter Property="Foreground"
                                                        Value="#FF9800"/>
                                                <Setter Property="ToolTip"
                                                        Value="省电模式"/>
                                            </DataTrigger>
                                            <!-- 当EnableIdleAutoPowerSaving禁用时，图标置灰 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding PowerSaving.EnableIdleAutoPowerSaving}"
                                                               Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity"
                                                        Value="0.3"/>
                                                <Setter Property="Foreground"
                                                        Value="#9E9E9E"/>
                                                <Setter Property="ToolTip"
                                                        Value="空闲自动省电已禁用"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </StatusBarItem>

                        <!-- 软件包操作进度指示器（放在省电图标右侧） -->
                        <StatusBarItem x:Name="PackageProgressItem"
                                       Visibility="Collapsed"
                                       Margin="4,0,0,0">
                            <Button x:Name="PackageProgressButton"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="28"
                                    Padding="8,4"
                                    Click="PackageProgressButton_Click"
                                    ToolTip="点击展开进度面板">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Package"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="#2196F3"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PackageProgressText"
                                               Text="正在打包..."
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PackageProgressPercentage"
                                               Text="0%"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="#2196F3"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StatusBarItem>

                        <!-- 文件传输状态指示器 -->
                        <StatusBarItem x:Name="TransferStatusItem"
                                       Visibility="Collapsed"
                                       Margin="4,0,0,0">
                            <Button x:Name="TransferStatusButton"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Height="28"
                                    Padding="8,4"
                                    Click="TransferStatusButton_Click"
                                    ToolTip="点击打开传输列表">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SwapVertical"
                                                             Width="16"
                                                             Height="16"
                                                             VerticalAlignment="Center"
                                                             Foreground="#2196F3"
                                                             Margin="0,0,4,0"/>
                                    <TextBlock x:Name="TransferStatusText"
                                               Text=""
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="#616161"/>
                                </StackPanel>
                            </Button>
                        </StatusBarItem>

                        <StatusBarItem DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Alarm"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="#9E9E9E"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Name="clockText"
                                           Foreground="#616161"
                                           FontWeight="Normal"
                                           FontSize="12"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding CurrentTime, StringFormat='yyyy-MM-dd HH:mm:ss', FallbackValue='2023-02-01 00:00:00'}"/>
                            </StackPanel>
                        </StatusBarItem>
                    </StatusBar>
                </Border>

                <Grid ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="55*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:ColorZone Mode="Standard"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              Padding="12,12,4,12">
                        <materialDesign:Card Padding="12"
                                             UniformCornerRadius="8"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <TreeView x:Name="ProcessTree"
                                      VerticalContentAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      DataContext="{Binding}"
                                      ItemContainerStyle="{StaticResource ProcessTreeViewItemStyle}"
                                      Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type models:ProcessItem}"
                                                              ItemsSource="{Binding Children}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <!-- 主要节点内容 -->
                                            <Border x:Name="NodeBorder"
                                                    CornerRadius="6"
                                                    Margin="0,2"
                                                    Padding="4,4"
                                                    Background="Transparent">

                                                <!-- 使用Grid分两行布局 -->
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 第一行：自定义名称 + 按钮（仅此区域高亮） -->
                                                    <Border Grid.Row="0"
                                                            CornerRadius="4"
                                                            Padding="6 2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background"
                                                                        Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=IsMouseOver}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="#E3F2FD"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TreeViewItem}}, Path=IsSelected}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="#BBDEFB"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid MinHeight="26"
                                                              Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Column="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0"
                                                                           VerticalAlignment="Center"
                                                                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                                                                           FontWeight="Bold"
                                                                           Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}"/>
                                                                <StackPanel Grid.Column="1"
                                                                            HorizontalAlignment="Left"
                                                                            Orientation="Horizontal"
                                                                            Visibility="{Binding NameInputVisibility}">
                                                                    <TextBox Text="{Binding NameField}"
                                                                             VerticalAlignment="Bottom"
                                                                             FontSize="11"
                                                                             MinWidth="100"
                                                                             MaxWidth="400"/>
                                                                    <Button Style="{StaticResource MiniActionButtonStyle}"
                                                                            Margin="0 0 5 0"
                                                                            Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}, AncestorLevel=1}, Path=DataContext.ConfirmNameInput}"
                                                                            CommandParameter="{Binding RelativeSource={RelativeSource Self},Path=DataContext}">
                                                                        <materialDesign:PackIcon Kind="CheckBold"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource MiniActionButtonStyle}"
                                                                            Command="{Binding DisableNameInput}">
                                                                        <materialDesign:PackIcon Kind="CloseThick"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Column="1"
                                                                        HorizontalAlignment="Right"
                                                                        Orientation="Horizontal">
                                                                <ToggleButton Height="15"
                                                                              Margin="0 0 20 0"
                                                                              Cursor="Hand"
                                                                              Command="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}, AncestorLevel=1}, Path=DataContext.ToggleEnable}"
                                                                              CommandParameter="{Binding RelativeSource={RelativeSource Self},Path=DataContext}"
                                                                              ToolTip="[启用|忽略]该进程"
                                                                              IsChecked="{Binding Enable}"/>
                                                                <Button Command="{Binding RunNodeCommand}"
                                                                        ToolTip="启动该进程"
                                                                        Style="{StaticResource ProcessControlButtonStyle}"
                                                                        Visibility="{Binding BtnRunVisibility}">
                                                                    <fa:ImageAwesome Icon="Play"
                                                                                     Width="{StaticResource SmallIconSize}"
                                                                                     Height="{StaticResource SmallIconSize}"
                                                                                     Foreground="ForestGreen"/>
                                                                </Button>
                                                                <Button Style="{StaticResource ProcessControlButtonStyle}"
                                                                        IsEnabled="False"
                                                                        Visibility="{Binding BtnLoadingVisibility}">
                                                                    <fa:ImageAwesome Icon="Spinner"
                                                                                     Width="{StaticResource MediumIconSize}"
                                                                                     Height="{StaticResource MediumIconSize}"
                                                                                     Spin="True"
                                                                                     SpinDuration="1"/>
                                                                </Button>
                                                                <Button ToolTip="结束该进程"
                                                                        Command="{Binding KillNodeCommand}"
                                                                        Style="{StaticResource ProcessControlButtonStyle}"
                                                                        IsEnabled="True"
                                                                        Visibility="{Binding BtnStopVisibility}">
                                                                    <fa:ImageAwesome Icon="Stop"
                                                                                     Width="{StaticResource SmallIconSize}"
                                                                                     Height="{StaticResource SmallIconSize}"
                                                                                     Foreground="Red"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- 第二行：详细信息 -->
                                                    <ContentControl Grid.Row="1"
                                                                    Content="{Binding}">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSuperRoot}"
                                                                                 Value="False">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                        <Setter Property="ContentTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,2,0,0">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <!-- 左侧：进程名和延时（可截断保证延时显示） -->
                                                                                        <Grid Grid.Column="0">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                            </Grid.ColumnDefinitions>

                                                                                            <TextBlock Grid.Column="0"
                                                                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                       Foreground="#666666"
                                                                                                       Text="进程名: "/>
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                       Foreground="#666666"
                                                                                                       FontWeight="Medium"
                                                                                                       Text="{Binding Path}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       ToolTip="{Binding Path}"/>
                                                                                            <TextBlock Grid.Column="2"
                                                                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                       Foreground="#666666"
                                                                                                       Margin="16,0,0,0"
                                                                                                       Text="延时: "/>
                                                                                            <TextBlock Grid.Column="3"
                                                                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                       Foreground="#666666"
                                                                                                       FontWeight="Medium"
                                                                                                       Text="{Binding Delay}"/>
                                                                                            <TextBlock Grid.Column="4"
                                                                                                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                       Foreground="#666666"
                                                                                                       Text="ms"/>
                                                                                        </Grid>

                                                                                        <!-- 右侧：ID（始终显示） -->
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                                                   Margin="16,0,0,0"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Foreground="#d1d5db"
                                                                                                   FontFamily="Consolas"
                                                                                                   Text="{Binding ShortNodeId}"/>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </materialDesign:Card>
                    </materialDesign:ColorZone>

                    <Grid Grid.Column="1"
                          ShowGridLines="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45*"/>
                            <RowDefinition Height="55*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0"
                                             Margin="6,12,12,6"
                                             Padding="0"
                                             UniformCornerRadius="8"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#E3F2FD"
                                        CornerRadius="8,8,0,0"
                                        Padding="14,10">
                                    <TextBlock Text="💻 计算机配置信息"
                                               Foreground="#1976D2"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Border>
                                <RichTextBox x:Name="hardwareInfoBox"
                                             Grid.Row="1"
                                             Margin="14,12"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0"
                                             BorderBrush="Transparent"
                                             Background="Transparent"
                                             IsReadOnly="True"
                                             FontFamily="{DynamicResource MaterialDesignFont}"
                                             IsUndoEnabled="False"
                                             FocusVisualStyle="{x:Null}">
                                    <RichTextBox.Document>
                                        <FlowDocument/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </Grid>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="1"
                                             Margin="6,6,12,12"
                                             Padding="0"
                                             UniformCornerRadius="8"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#E8F5E9"
                                        CornerRadius="8,8,0,0"
                                        Padding="14,10">
                                    <TextBlock Text="📋 实时日志"
                                               Foreground="#388E3C"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                </Border>
                                <RichTextBox x:Name="logBox"
                                             Grid.Row="1"
                                             Margin="14,12"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderThickness="0"
                                             BorderBrush="Transparent"
                                             Background="Transparent"
                                             IsReadOnly="True"
                                             FontSize="12"
                                             FontFamily="Consolas, Microsoft YaHei"
                                             IsUndoEnabled="False"
                                             FocusVisualStyle="{x:Null}">
                                    <RichTextBox.Document>
                                        <FlowDocument/>
                                    </RichTextBox.Document>
                                </RichTextBox>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>


                </Grid>
            </DockPanel>
        </DockPanel>
    </materialDesign:DialogHost>
</reactiveui:ReactiveWindow>
