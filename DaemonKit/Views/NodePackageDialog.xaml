<Window x:Class="DaemonKit.Views.NodePackageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:DaemonKit.Converters"
        Title="应用更新包"
        Height="520"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BooleanInverterConverter x:Key="InverseBoolConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 标题 -->
            <RowDefinition Height="Auto"/>  <!-- 包信息 -->
            <RowDefinition Height="Auto"/>  <!-- 匹配状态 -->
            <RowDefinition Height="Auto"/>  <!-- 安装目录（新增模式） -->
            <RowDefinition Height="*"/>     <!-- 节点选择列表 -->
            <RowDefinition Height="Auto"/>  <!-- 进度 -->
            <RowDefinition Height="Auto"/>  <!-- 按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Update" Width="28" Height="28"
                                         Foreground="#FF9800" VerticalAlignment="Center"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="应用更新包" FontSize="20" FontWeight="Medium"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- 包信息 -->
        <Border Grid.Row="1" Background="#FFF3E0" CornerRadius="8"
                Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#FFE0B2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 包类型 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="类型："
                           FontWeight="Medium" Foreground="#E65100"
                           Margin="0,0,12,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding PackageTypeText}" Foreground="#BF360C"
                           Margin="0,0,0,6"/>

                <!-- 应用模式（可选择） -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="模式："
                           FontWeight="Medium" Foreground="#E65100"
                           Margin="0,0,12,6"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            Margin="0,0,0,6"
                            Visibility="{Binding ShowPatchModeSelection, Converter={StaticResource BoolToVis}}">
                    <RadioButton Content="覆盖（保留已有文件）"
                                 IsChecked="{Binding IsOverlayMode}"
                                 Foreground="#BF360C"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>
                    <RadioButton Content="替换（清空后全量替换）"
                                 IsChecked="{Binding IsReplaceMode}"
                                 Foreground="#BF360C"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 目标程序 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="目标："
                           FontWeight="Medium" Foreground="#E65100"
                           Margin="0,0,12,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding TargetInfo}" Foreground="#BF360C"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>

                <!-- 描述 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="描述："
                           FontWeight="Medium" Foreground="#E65100"
                           Margin="0,0,12,0"
                           Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding Description}" Foreground="#795548"
                           TextWrapping="Wrap"
                           Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibility}}"/>
            </Grid>
        </Border>

        <!-- 匹配状态 -->
        <TextBlock Grid.Row="2" Text="{Binding MatchStatus}"
                   FontSize="13" Foreground="#555"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- 安装目录选择（新增节点模式） -->
        <Border Grid.Row="3" Margin="0,0,0,12"
                Padding="12,10" CornerRadius="6"
                Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1"
                Visibility="{Binding ShowInstallDirectory, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="安装目录" FontWeight="Medium" Foreground="#2E7D32"
                           Margin="0,0,0,6" FontSize="13"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="浏览..."
                            Margin="8,0,0,0"
                            Padding="12,4"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding BrowseInstallDirCommand}"/>
                    <TextBox Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="选择程序安装目录..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </DockPanel>
                <TextBlock Text="将程序文件解压到此目录，并在进程树中新增节点。"
                           FontSize="11" Foreground="#66BB6A" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- 节点选择列表 -->
        <Border Grid.Row="4" Margin="0,0,0,12"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding ShowNodeSelection, Converter={StaticResource BoolToVis}}">
            <ListBox ItemsSource="{Binding CandidateNodes}"
                     SelectedItem="{Binding SelectedNode}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MaxHeight="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,3">
                            <materialDesign:PackIcon Kind="Application" Width="16" Height="16"
                                                     Foreground="#1976D2"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock FontWeight="Medium" FontSize="13">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="MetaData.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="#888"
                                           Text="{Binding MetaData.Path}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 不需要选择时的自动匹配信息（占位） -->
        <Border Grid.Row="4" Margin="0,0,0,12"
                Visibility="{Binding ShowNodeSelection, Converter={StaticResource BoolToVis}, ConverterParameter=True}">
            <!-- 留空即可，匹配信息已在 Row=2 的 MatchStatus 中显示 -->
        </Border>

        <!-- 进度区域 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,12"
                    Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12" Foreground="#555" Margin="0,0,0,6"/>
            <ProgressBar Value="{Binding ProgressPercentage}"
                         Maximum="100" Height="6"
                         Foreground="#FF9800"/>
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="取消" Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding CancelCommand}"
                    IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="应用更新"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ApplyCommand}"
                    Background="#FF9800" Foreground="White"
                    materialDesign:ButtonAssist.CornerRadius="4"/>
        </StackPanel>
    </Grid>
</Window>
