<Window x:Class="DaemonKit.Views.NodePackageExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:DaemonKit.Models"
        Title="导出节点包"
        Width="580"
        Height="720"
        MinHeight="480"
        MinWidth="500"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,16"
                   Text="导出节点包"/>

        <!-- 节点信息 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="目标节点"/>
            <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                       FontWeight="Bold"
                       Text="{Binding NodeName}"/>
            <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="{Binding ExeName}"/>
        </StackPanel>

        <!-- 包类型选择 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Margin="0,0,0,4"
                       Text="包类型"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="全量包（完整程序目录）"
                             IsChecked="{Binding IsNodeFull}"
                             Margin="0,0,16,0"
                             Style="{StaticResource MaterialDesignRadioButton}"/>
                <RadioButton Content="补丁包（选择文件）"
                             IsChecked="{Binding IsNodePatch}"
                             Style="{StaticResource MaterialDesignRadioButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- 文件选择区域（仅 Patch 时可见） -->
        <Grid Grid.Row="3" Margin="0,0,0,12"
              Visibility="{Binding FileSelectionVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题行：标签 + 操作按钮 -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           VerticalAlignment="Center"
                           Text="选择要包含的文件"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Padding="6,2" Height="26"
                            Margin="0,0,4,0"
                            FontSize="12"
                            Command="{Binding SelectAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="全选" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="6,2" Height="26"
                            Margin="0,0,4,0"
                            FontSize="12"
                            Command="{Binding DeselectAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckboxBlankOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="全不选" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="6,2" Height="26"
                            FontSize="12"
                            Command="{Binding CollapseAllCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CollapseAll" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <TextBlock Text="折叠" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>

            <!-- 搜索框（独立一行，带搜索图标） -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox Padding="28,6,0,6"
                         materialDesign:HintAssist.Hint="搜索文件名..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.IsFloating="False"
                         FontSize="13"/>
                <materialDesign:PackIcon Kind="Magnify"
                                         Width="18" Height="18"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Margin="8,0,0,0"
                                         Opacity="0.4"
                                         IsHitTestVisible="False"/>
            </Grid>

            <!-- 选择摘要（树上方） -->
            <TextBlock Grid.Row="2"
                       Text="{Binding FileSelectionSummary}"
                       Margin="0,0,0,4"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>

            <!-- 文件树 -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <TreeView ItemsSource="{Binding FileTreeRoots}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          BorderThickness="0"
                          Padding="4,2">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type models:FileTreeNode}"
                                                  ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          IsThreeState="{Binding IsDirectory}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"/>
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Width="18" Height="18">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="FileOutline"/>
                                            <Setter Property="Foreground" Value="#90A4AE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="Kind" Value="FolderOutline"/>
                                                    <Setter Property="Foreground" Value="#FFA726"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding FormattedSize}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Opacity="0.5"
                                           FontSize="11"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"
                               BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                            <Setter Property="Padding" Value="0,1"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>
        </Grid>

        <!-- 版本号 -->
        <TextBox Grid.Row="4"
                 Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="版本号（可选，如 1.0.0）"
                 Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- 描述 -->
        <TextBox Grid.Row="5"
                 Margin="0,0,0,12"
                 materialDesign:HintAssist.Hint="描述（可选）"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="80"
                 VerticalScrollBarVisibility="Auto"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

        <!-- 进度 -->
        <StackPanel Grid.Row="6"
                    VerticalAlignment="Center"
                    Visibility="{Binding ProgressVisibility}">
            <ProgressBar IsIndeterminate="True"
                         Margin="0,0,0,8"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MaterialDesignCaptionTextBlock}"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="导出"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding ExportCommand}"
                    IsEnabled="{Binding CanExport}"/>
        </StackPanel>
    </Grid>
</Window>
