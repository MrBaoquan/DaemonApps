<Window x:Class="DaemonKit.Views.ResourceLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DaemonKit.Converters"
        xmlns:vm="clr-namespace:DaemonKit.ViewModels"
        xmlns:models="clr-namespace:DaemonKit.Models"
        d:DataContext="{d:DesignInstance vm:ResourceLibraryViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="资源库" 
        Height="620" Width="1080"
        MinHeight="400" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 文件分类→图标 -->
        <converters:ResourceCategoryToIconConverter x:Key="CategoryToIcon"/>

        <!-- 文件分类→颜色 -->
        <converters:ResourceCategoryToColorConverter x:Key="CategoryToColor"/>

        <!-- Bool反转 -->
        <Style x:Key="CollapsedWhenTrue" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="资源库" FontSize="14" FontWeight="Medium" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Foreground="White" Opacity="0.8" FontSize="12" VerticalAlignment="Center">
                        <Run Text="设备"/><Run Text="{Binding OnlineDeviceCount, Mode=OneWay}"/>
                        <Run Text="台  文件"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text="个"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="刷新资源库" Width="32" Height="32">
                    <materialDesign:PackIcon Kind="Refresh" Foreground="White" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- 2. 工具栏：搜索 + 分类筛选 + 批量操作 -->
        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索框 -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="搜索文件名或设备..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="12" Height="32"
                         Padding="8,4" Margin="0,0,8,0"
                         VerticalContentAlignment="Center"/>

                <!-- 分类筛选 -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          FontSize="12" Width="100" Height="32"
                          Padding="8,4" Margin="0,0,8,0"/>

                <!-- 批量下载 -->
                <Button Grid.Column="2"
                        Command="{Binding DownloadSelectedCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        ToolTip="下载选中文件" Width="32" Height="32">
                    <materialDesign:PackIcon Kind="Download" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- 3. 文件列表 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Files}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeight="42"
                  FontSize="12.5"
                  Margin="0">

            <DataGrid.Columns>
                <!-- 选择列（表头含全选） -->
                <DataGridTemplateColumn Width="50" MinWidth="50">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 文件名 -->
                <DataGridTemplateColumn Header="文件名" Width="3*" MinWidth="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 类型：图标+文字 -->
                <DataGridTemplateColumn Header="类型" Width="90" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <materialDesign:PackIcon Kind="{Binding Category, Converter={StaticResource CategoryToIcon}}"
                                                         Foreground="{Binding Category, Converter={StaticResource CategoryToColor}}"
                                                         Width="14" Height="14" VerticalAlignment="Center"
                                                         Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding CategoryText}" VerticalAlignment="Center"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 文件大小 -->
                <DataGridTemplateColumn Header="大小" Width="120" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileSizeFormatted}" VerticalAlignment="Center"
                                       Padding="4,0" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 来源设备（含 IP） -->
                <DataGridTemplateColumn Header="来源设备" Width="2*" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding SourceDeviceName, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <!-- 本机标签 -->
                                <Border Background="#E3F2FD" CornerRadius="3" Padding="4,1" Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsLocalDevice, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="本机" FontSize="10" Foreground="#1565C0"/>
                                </Border>
                                <!-- 远程IP -->
                                <TextBlock Foreground="#999" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocalDevice}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="("/><Run Text="{Binding SourceDeviceIP, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 修改时间 -->
                <DataGridTemplateColumn Header="修改时间" Width="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LastModified, StringFormat=yyyy-MM-dd HH:mm}" VerticalAlignment="Center"
                                       Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 操作列 -->
                <DataGridTemplateColumn Header="操作" Width="150" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" Margin="4,0">
                                <!-- 未下载：下载/部署按钮 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Height="26" Padding="8,0,10,0" FontSize="12">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="Download"/>
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPackage}" Value="True">
                                                                <Setter Property="Kind" Value="PackageVariant"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPatch}" Value="True">
                                                                <Setter Property="Kind" Value="Update"/>
                                                                <Setter Property="Foreground" Value="#FF9800"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="下载"/>
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPackage}" Value="True">
                                                                <Setter Property="Text" Value="部署"/>
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPatch}" Value="True">
                                                                <Setter Property="Text" Value="更新"/>
                                                                <Setter Property="Foreground" Value="#FF9800"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 状态2：等待中（Pending） -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DownloadState, Converter={converters:EnumToVisibilityConverter}, ConverterParameter=Pending}">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True" Value="0"
                                                 Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="等待中..." FontSize="11" Foreground="#888"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- 状态3：下载中/已暂停 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding CanPauseResume, Converter={StaticResource BoolToVis}}">
                                    <!-- 圆形进度条 + 百分比 -->
                                    <Grid Width="28" Height="28" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     Value="{Binding DownloadProgress, Mode=OneWay}"
                                                     Minimum="0" Maximum="100"
                                                     IsIndeterminate="False"
                                                     Width="28" Height="28"/>
                                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0:F0}%}"
                                                   FontSize="7" Foreground="#333"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <!-- 速度 -->
                                    <TextBlock Text="{Binding DownloadSpeed}" FontSize="10" Foreground="#666"
                                               VerticalAlignment="Center" Width="48"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,2,0"/>
                                    <!-- 暂停/恢复 -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.PauseResumeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Width="22" Height="22">
                                        <materialDesign:PackIcon Width="12" Height="12">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="Pause"/>
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                            <Setter Property="Kind" Value="Play"/>
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Button>
                                    <!-- 取消 -->
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.CancelDownloadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="取消" Width="22" Height="22">
                                        <materialDesign:PackIcon Kind="Close" Width="12" Height="12" Foreground="#E53935"/>
                                    </Button>
                                </StackPanel>

                                <!-- 已完成 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircle" Width="12" Height="12"
                                                                     Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="已下载" FontSize="11" Foreground="#388E3C" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="打开文件夹" Width="24" Height="24" Padding="0">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Foreground="#1976D2"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DeployFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="部署进程包" Width="24" Height="24" Padding="0"
                                            Visibility="{Binding IsPackage, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14" Foreground="#388E3C"/>
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.ApplyNodePackageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="应用更新包" Width="24" Height="24" Padding="0"
                                            Visibility="{Binding IsPatch, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="Update" Width="14" Height="14" Foreground="#FF9800"/>
                                    </Button>
                                </StackPanel>

                                <!-- 失败 -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding DownloadState, Converter={converters:EnumToVisibilityConverter}, ConverterParameter=Failed}">
                                    <Border Background="#FFEBEE" CornerRadius="3" Padding="6,2" Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AlertCircle" Width="12" Height="12"
                                                                     Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBlock Text="失败" FontSize="11" Foreground="#C62828" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                            Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="重试" Width="24" Height="24" Padding="0">
                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Foreground="#E53935"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 扫描进度条（非阻塞，用户可同时浏览已加载的文件） -->
        <ProgressBar Grid.Row="2" VerticalAlignment="Top" Height="3"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                     Panel.ZIndex="1"
                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <!-- 空状态提示（无文件且未在扫描时显示） -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Panel.ZIndex="0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding TotalCount}" Value="0"/>
                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="48" Height="48"
                                     Foreground="#CCC" HorizontalAlignment="Center"/>
            <TextBlock Text="没有找到共享文件" Foreground="#999" Margin="0,8,0,0"
                       HorizontalAlignment="Center" FontSize="13"/>
        </StackPanel>

        <!-- 4. 底部状态栏 -->
        <Border Grid.Row="3" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" Foreground="#888"
                           Text="{Binding StatusText}"/>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#666"
                           Margin="0,0,12,0">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                    <Run Text=" 个"/>
                </TextBlock>

                <Button Grid.Column="2" Content="关闭"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="CloseButton_Click" Padding="12,2" Height="26" FontSize="12"
                        Foreground="#888"/>
            </Grid>
        </Border>
    </Grid>
</Window>
