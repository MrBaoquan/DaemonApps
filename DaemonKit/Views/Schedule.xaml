<reactiveui:ReactiveWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:local="clr-namespace:DaemonKit"
                           xmlns:core="clr-namespace:DaemonKit.Core"
                           xmlns:converters="clr-namespace:DaemonKit.Converters"
                           xmlns:reactiveui="http://reactiveui.net"
                           x:Class="DaemonKit.Schedule"
                           x:TypeArguments="local:ScheduleViewModel"
                           xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                           mc:Ignorable="d"
                           Title="计划任务"
                           Height="620"
                           Width="1080"
                           FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <converters:ScheduleTriggerTypeToStringConverter x:Key="ScheduleTriggerTypeToStringConverter"/>
        <converters:ScheduleTaskActionToStringConverter x:Key="ScheduleTaskActionToStringConverter"/>
        <converters:ScheduleTaskDescriptionConverter x:Key="ScheduleTaskDescriptionConverter"/>
        <converters:IndexToDisplayConverter x:Key="IndexToDisplayConverter"/>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 全局设置栏 -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="#E8E8E8">
            <Grid Margin="20,12,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 全局启用/禁用开关 -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="启用计划任务"
                               FontSize="12"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ToggleButton Grid.Column="1"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding GlobalSchedule.ScheduleTasksEnabled}"
                                  ToolTip="启用或禁用所有计划任务"/>
                </Grid>

                <!-- 工具栏按钮 -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding AddTaskConfigCommand}"
                            Height="36"
                            Padding="16,0"
                            FontSize="12"
                            ToolTip="添加新任务">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus"
                                                     Width="16"
                                                     Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0"/>
                            <TextBlock Text="添加"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,0">
            <!-- 任务列表 -->
            <DataGrid ItemsSource="{Binding ScheduleTaskConfigs}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      VerticalGridLinesBrush="Transparent"
                      FontSize="13"
                      RowHeight="52"
                      AlternationCount="1000000"
                      SelectedItem="{Binding SelectedTaskConfig}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader"
                           BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="Foreground"
                                Value="#37474F"/>
                        <Setter Property="Background"
                                Value="#F8F9FA"/>
                        <Setter Property="Height"
                                Value="44"/>
                        <Setter Property="Padding"
                                Value="12,0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>
                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>
                        <Setter Property="BorderBrush"
                                Value="#E0E0E0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell"
                           BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Padding"
                                Value="12,0"/>
                        <Setter Property="Foreground"
                                Value="#546E7A"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!-- 任务ID（序号） -->
                    <DataGridTemplateColumn Header="ID"
                                            Width="80"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <Binding RelativeSource="{RelativeSource AncestorType=DataGridRow}"
                                                 Path="AlternationIndex"
                                                 Converter="{StaticResource IndexToDisplayConverter}"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 触发方式 -->
                    <DataGridTemplateColumn Header="触发方式"
                                            Width="150"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Trigger, Converter={StaticResource ScheduleTriggerTypeToStringConverter}}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="13"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 执行操作 -->
                    <DataGridTemplateColumn Header="执行操作"
                                            Width="120"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action, Converter={StaticResource ScheduleTaskActionToStringConverter}}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="13"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 描述 -->
                    <DataGridTemplateColumn Header="描述"
                                            Width="*"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           TextAlignment="Left"
                                           TextWrapping="Wrap"
                                           FontSize="13">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ScheduleTaskDescriptionConverter}">
                                            <Binding Path="Trigger"/>
                                            <Binding Path="DailyTime"/>
                                            <Binding Path="DelaySeconds"/>
                                            <Binding Path="Action"/>
                                            <Binding Path="TargetNodeName"/>
                                            <Binding Path="ClickX"/>
                                            <Binding Path="ClickY"/>
                                            <Binding Path="MaxExecuteCount"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 操作 -->
                    <DataGridTemplateColumn Header="操作"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button Click="EditButton_Click"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Margin="0,0,4,0"
                                            ToolTip="编辑任务">
                                        <materialDesign:PackIcon Kind="Pencil"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#64B5F6"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            ToolTip="删除任务">
                                        <materialDesign:PackIcon Kind="DeleteOutline"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#E57373"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 启用状态 (ToggleSwitch at the end) -->
                    <DataGridTemplateColumn Header="启用"
                                            Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              HorizontalAlignment="Center"
                                              ToolTip="启用/禁用任务"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</reactiveui:ReactiveWindow>