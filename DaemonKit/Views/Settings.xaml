<reactiveui:ReactiveWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DaemonKit"
    x:Class="DaemonKit.Settings"
    x:TypeArguments="local:SettingsViewModel"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:reactiveui="http://reactiveui.net"
    mc:Ignorable="d"
    WindowStartupLocation="CenterScreen"
    Title="设置"
    Height="650"
    Width="500"
    ResizeMode="NoResize"
    Topmost="True"
    FontFamily="{DynamicResource MaterialDesignFont}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- 自定义滚动条样式 -->
        <Style x:Key="ScrollBarThumb"
               TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="IsTabStop"
                    Value="False"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#CCCCCC"
                                CornerRadius="3"
                                Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                     Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomScrollBar"
               TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Width"
                    Value="6"/>
            <Setter Property="MinWidth"
                    Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomScrollViewer"
               TargetType="{x:Type ScrollViewer}">
            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource CustomScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Margin="6,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource CustomScrollViewer}">
            <StackPanel Orientation="Vertical">
                <!-- 基本设置分组 -->
                <TextBlock Text="基本设置"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <Separator Margin="0,0,0,15"/>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="桌面快捷方式"
                                   FontSize="14"/>
                        <TextBlock Text="在桌面创建应用程序快捷方式"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=ShortCut, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开机启动"
                                   FontSize="14"/>
                        <TextBlock Text="系统启动时自动运行程序"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=StartUp, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启动后最小化运行"
                                   FontSize="14"/>
                        <TextBlock Text="程序启动后自动最小化到托盘"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=MinimizeStartUp, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="启动后禁用桌面"
                                   FontSize="14"/>
                        <TextBlock Text="隐藏 Windows 资源管理器"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=DisableExplorer, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="禁用触摸屏"
                                   FontSize="14"/>
                        <TextBlock Text="禁用所有触摸屏输入设备"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=DisableTouchScreen, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="倒计时确认"
                                   FontSize="14"/>
                        <TextBlock Text="重启/关机前显示倒计时10秒确认"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=EnableCountdownConfirm, Mode=TwoWay}"/>
                </DockPanel>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="专注模式"
                                   FontSize="14"/>
                        <TextBlock Text="长时间无操作：杀桌面、启动进程树"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=EnableIdleAutoAction, Mode=TwoWay}"/>
                </DockPanel>

                <StackPanel Margin="0,8,0,0"
                            IsEnabled="{Binding Path=EnableIdleAutoAction, Mode=TwoWay}"
                            Visibility="{Binding Path=EnableIdleAutoAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="无操作阈值"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding IdleAutoActionThresholdMinutes}"
                             materialDesign:TextFieldAssist.SuffixText="分钟"/>
                </StackPanel>

                <!-- 空闲自动省电模式 -->
                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,15,0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="空闲自动省电"
                                   FontSize="14"/>
                        <TextBlock Text="长时间无输入：自动进入/退出省电模式"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=EnableIdleAutoPowerSaving, Mode=TwoWay}"/>
                </DockPanel>

                <StackPanel Margin="0,8,0,0"
                            IsEnabled="{Binding Path=EnableIdleAutoPowerSaving, Mode=TwoWay}"
                            Visibility="{Binding Path=EnableIdleAutoPowerSaving, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="空闲时长阈值"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding IdleAutoPowerSavingThresholdMinutes}"
                             materialDesign:TextFieldAssist.SuffixText="分钟"/>
                </StackPanel>

                <!-- 进阶设置分组 -->
                <TextBlock Text="进阶设置"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,25,0,10"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <Separator Margin="0,0,0,15"/>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="开机后延迟启动"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding StartUpDelay}"
                             materialDesign:TextFieldAssist.SuffixText="秒"/>
                </StackPanel>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="延迟启动进程树"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding DelayDaemon}"
                             materialDesign:TextFieldAssist.SuffixText="ms"/>
                </StackPanel>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="进程守护间隔"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding DaemonInterval}"
                             materialDesign:TextFieldAssist.SuffixText="ms"/>
                </StackPanel>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="无响应容忍度"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding ErrorCount}"
                             materialDesign:TextFieldAssist.SuffixText="次"/>
                </StackPanel>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="Crash进程 (多个以 | 分隔)"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding CrashWindows}"/>
                </StackPanel>

                <StackPanel Margin="0,8">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="最大并发传输数"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding MaxConcurrentTransfers}"
                             materialDesign:TextFieldAssist.SuffixText="个"/>
                </StackPanel>

                <!-- 安全关闭设置分组 -->
                <TextBlock Text="安全关闭"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,25,0,10"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <Separator Margin="0,0,0,15"/>

                <DockPanel Height="40"
                           VerticalAlignment="Center"
                           Margin="0,5">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="安全关闭进程"
                                   FontSize="14"/>
                        <TextBlock Text="使用更安全的方式关闭进程"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right"
                                  IsChecked="{Binding Path=SafeKillProcess, Mode=TwoWay}"/>
                </DockPanel>

                <StackPanel Margin="0,8,0,20"
                            IsEnabled="{Binding Path=SafeKillProcess, Mode=TwoWay}"
                            Visibility="{Binding Path=SafeKillProcess, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBox FontSize="14"
                             materialDesign:HintAssist.Hint="安全关闭超时时间"
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding SafeKillTimeout}"
                             materialDesign:TextFieldAssist.SuffixText="ms"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                Padding="0,15,0,15"
                Margin="-20,15,-20,0"
                Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button Margin="10,0"
                        Width="100"
                        Height="36"
                        Content="应用"
                        Command="{Binding Confirm}"/>
                <Button Margin="10,0"
                        Width="100"
                        Height="36"
                        Content="取消"
                        Command="{Binding Cancel}"/>
            </StackPanel>
        </Border>
    </Grid>

</reactiveui:ReactiveWindow>
