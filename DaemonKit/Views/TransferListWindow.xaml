<Window x:Class="DaemonKit.Views.TransferListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:DaemonKit.Converters"
        xmlns:vm="clr-namespace:DaemonKit.ViewModels"
        xmlns:models="clr-namespace:DaemonKit.Models"
        d:DataContext="{d:DesignInstance vm:TransferListViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="文件传输管理" 
        Height="620" Width="850"
        MinHeight="400" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <converters:TransferStateToStringConverter x:Key="StateConverter"/>
        <converters:TransferStateToBrushConverter x:Key="StateColorConverter"/>
        <converters:BytesToHumanReadableConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 活跃任务项模板 -->
        <DataTemplate x:Key="ActiveTaskTemplate" DataType="{x:Type models:TransferTaskItem}">
            <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="12,10" Background="White"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：图标 + 文件名 + 来源 + 操作按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 方向图标 -->
                        <materialDesign:PackIcon Grid.Column="0" Width="22" Height="22" 
                                                 VerticalAlignment="Center" Margin="0,0,10,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Direction}" Value="Upload">
                                            <Setter Property="Kind" Value="CloudUpload"/>
                                            <Setter Property="Foreground" Value="#2196F3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Direction}" Value="Download">
                                            <Setter Property="Kind" Value="CloudDownload"/>
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>

                        <!-- 文件名和来源 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="Medium" FontSize="13.5"
                                       TextTrimming="CharacterEllipsis" 
                                       ToolTip="{Binding FileName}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="#888" Margin="0,0,10,0"/>
                                <TextBlock FontSize="11" Foreground="#AAA">
                                    <Run Text="{Binding RemoteDeviceName, Mode=OneWay}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding RemoteDeviceIP, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 状态文本 -->
                        <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11.5" FontWeight="Medium"
                                   Foreground="{Binding State, Converter={StaticResource StateColorConverter}}"
                                   VerticalAlignment="Center" Margin="8,0"/>

                        <!-- 操作按钮组 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="暂停" Width="30" Height="30"
                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="Pause" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="继续" Width="30" Height="30"
                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Foreground="#4CAF50"/>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="取消" Width="30" Height="30"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#F44336"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行：进度条 -->
                    <ProgressBar Grid.Row="1" Value="{Binding Progress, Mode=OneWay}" 
                                 Maximum="100" Height="6" Margin="32,8,0,4"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="#4CAF50"/>
                        </ProgressBar.Foreground>
                    </ProgressBar>

                    <!-- 第三行：进度详情 (已传输/总量  速度  剩余时间) -->
                    <Grid Grid.Row="2" Margin="32,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 进度百分比 -->
                        <TextBlock Grid.Column="0" FontSize="11.5" Foreground="#666" VerticalAlignment="Center">
                            <Run Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:F1}%}" FontWeight="SemiBold"/>
                        </TextBlock>

                        <!-- 已传输/总量 -->
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#999" 
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding ProgressDisplay, Mode=OneWay}"/>

                        <!-- 速度 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <materialDesign:PackIcon Kind="Speedometer" Width="14" Height="14" 
                                                     Foreground="#4CAF50" VerticalAlignment="Center"
                                                     Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding SpeedDisplay, Mode=OneWay}" FontSize="11.5" 
                                       Foreground="#4CAF50" FontWeight="Medium"/>
                        </StackPanel>

                        <!-- 分隔线 -->
                        <TextBlock Grid.Column="3" Text="·" Foreground="#CCC" Margin="10,0" 
                                   VerticalAlignment="Center" FontSize="14"/>

                        <!-- 剩余时间 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" 
                                                     Foreground="#FF9800" VerticalAlignment="Center"
                                                     Margin="0,0,4,0"/>
                            <TextBlock FontSize="11.5" Foreground="#FF9800">
                                <Run Text="剩余 "/>
                                <Run Text="{Binding ETADisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 已完成任务项模板 -->
        <DataTemplate x:Key="CompletedTaskTemplate" DataType="{x:Type models:TransferTaskItem}">
            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="12,8" Background="White"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 状态图标 -->
                    <materialDesign:PackIcon Grid.Column="0" Width="20" Height="20" 
                                             VerticalAlignment="Center" Margin="0,0,10,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Failed">
                                        <Setter Property="Kind" Value="CloseCircle"/>
                                        <Setter Property="Foreground" Value="#F44336"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                        <Setter Property="Kind" Value="MinusCircle"/>
                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>

                    <!-- 文件名和来源 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="13" 
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding FileName}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="#AAA" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding RemoteDeviceName, Mode=OneWay}" FontSize="10.5" Foreground="#BBB"/>
                            <TextBlock Text=" · " FontSize="10.5" Foreground="#CCC"/>
                            <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="10.5" Foreground="#BBB"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 状态文本 -->
                    <TextBlock Grid.Column="2" Text="{Binding StateText}"
                               FontSize="11.5" VerticalAlignment="Center" Margin="8,0"
                               Foreground="{Binding State, Converter={StaticResource StateColorConverter}}"/>

                    <!-- 错误信息（仅失败时显示） -->
                    <TextBlock Grid.Column="3" Text="{Binding ErrorMessage}" 
                               FontSize="10.5" Foreground="#F44336" MaxWidth="150"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ErrorMessage}"
                               VerticalAlignment="Center" Margin="4,0"/>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 部署进程包（仅.dkp.zip已完成的下载任务显示） -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.DeployPackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="部署进程包" Width="28" Height="28"
                                Visibility="{Binding IsPackage, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="14" Height="14" Foreground="#4CAF50"/>
                        </Button>
                        <!-- 应用补丁包（仅.dkp-patch.zip已完成的下载任务显示） -->
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.ApplyPatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="应用更新包" Width="28" Height="28"
                                Visibility="{Binding IsPatch, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon Kind="Update" Width="14" Height="14" Foreground="#FF9800"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="打开文件位置" Width="28" Height="28">
                            <Button.IsEnabled>
                                <Binding Path="State">
                                    <Binding.Converter>
                                        <converters:TransferStateNotCancelledConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.IsEnabled>
                            <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Foreground="#666"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="移除记录" Width="28" Height="28">
                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#999"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部状态栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="文件传输" FontSize="14" FontWeight="Medium" Foreground="White" Margin="0,0,16,0"/>
                    <TextBlock Foreground="White" Opacity="0.8" FontSize="12" VerticalAlignment="Center">
                        <Run Text="↑"/><Run Text="{Binding UploadCount, Mode=OneWay}"/>
                        <Run Text="  ↓"/><Run Text="{Binding DownloadCount, Mode=OneWay}"/>
                        <Run Text="  ✓"/><Run Text="{Binding CompletedCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="White" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding HasActiveTasks, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding TotalSpeedDisplay, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 批量操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding PauseAllCommand}" ToolTip="全部暂停"
                            IsEnabled="{Binding HasActiveTasks}" Width="32" Height="32">
                        <materialDesign:PackIcon Kind="PauseCircleOutline" Foreground="White" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding ResumeAllCommand}" ToolTip="全部恢复"
                            IsEnabled="{Binding HasActiveTasks}" Width="32" Height="32">
                        <materialDesign:PackIcon Kind="PlayCircleOutline" Foreground="White" Width="18" Height="18"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}"
                            Command="{Binding CancelAllCommand}" ToolTip="全部取消"
                            IsEnabled="{Binding HasActiveTasks}" Width="32" Height="32">
                        <materialDesign:PackIcon Kind="StopCircleOutline" Foreground="White" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Tab内容区（上传 / 下载 / 已完成） -->
        <TabControl Grid.Row="1" 
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Style="{StaticResource MaterialDesignFilledTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight">

            <!-- Tab1: 上传中 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18" 
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding UploadTabHeader, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <!-- 上传任务列表 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveUploadTasks}"
                                      ItemTemplate="{StaticResource ActiveTaskTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsUploadEmpty, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="CloudUploadOutline" Width="56" Height="56" 
                                                 Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无上传任务" FontSize="15" Opacity="0.4" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="发送文件到远程设备后将在此显示" FontSize="12" 
                                   Opacity="0.3" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab2: 下载中 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CloudDownload" Width="18" Height="18" 
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding DownloadTabHeader, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <!-- 下载任务列表 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ActiveDownloadTasks}"
                                      ItemTemplate="{StaticResource ActiveTaskTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsDownloadEmpty, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="56" Height="56" 
                                                 Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无下载任务" FontSize="15" Opacity="0.4" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="从远程设备下载文件后将在此显示" FontSize="12" 
                                   Opacity="0.3" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab3: 已完成 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" Width="18" Height="18" 
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CompletedTabHeader, Mode=OneWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="8,6" Background="#FAFAFA" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                        <Button Content="清除全部记录" Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ClearCompletedCommand}" FontSize="12"
                                Padding="12,4" Height="28" Foreground="#888"
                                HorizontalAlignment="Right"/>
                    </Border>

                    <!-- 已完成任务列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CompletedTasks}"
                                      ItemTemplate="{StaticResource CompletedTaskTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsCompletedEmpty, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="History" Width="48" Height="48" 
                                                 Opacity="0.25" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无传输记录" FontSize="14" Opacity="0.35" 
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. 底部栏 -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5" Foreground="#888"
                           Visibility="{Binding HasActiveTasks, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding TotalProgress, Mode=OneWay, StringFormat={}{0:F1}%}"/>
                </TextBlock>

                <ProgressBar Grid.Column="1" Value="{Binding TotalProgress, Mode=OneWay}" 
                             Maximum="100" Height="4" Margin="10,0"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Visibility="{Binding HasActiveTasks, Converter={StaticResource BoolToVis}}"/>

                <Button Grid.Column="2" Content="关闭" 
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Click="CloseButton_Click" Padding="12,2" Height="26" FontSize="12"
                        Foreground="#888"/>
            </Grid>
        </Border>
    </Grid>
</Window>
