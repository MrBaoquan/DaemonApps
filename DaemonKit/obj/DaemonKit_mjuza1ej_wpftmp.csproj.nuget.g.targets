    <Import Project="$(NuGetPackageRoot)materialdesignthemes\4.7.1\build\MaterialDesignThemes.targets" Condition="Exists('$(NuGetPackageRoot)materialdesignthemes\4.7.1\build\MaterialDesignThemes.targets')" />
  </ImportGroup>
</Project>