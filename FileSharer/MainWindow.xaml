<reactiveui:ReactiveWindow x:Class="FileSharer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileSharer"
        xmlns:viewmodels="clr-namespace:FileSharer.ViewModels"
        xmlns:reactiveui="http://reactiveui.net"
        x:TypeArguments="viewmodels:MainViewModel"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        Title="FileSharer" Height="460" MinHeight="550" Width="950" MinWidth="750">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                <materialDesign:PackIcon Kind="Server" Foreground="#0071cb" Margin="0 0 5 0" FontSize="12" />
                <TextBlock TextAlignment="Center" FontSize="12" 
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Foreground="#1a7f29"
                            Text="{Binding ServerText}" />
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock TextAlignment="Center" Margin="30 0" FontSize="18" 
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"
                         Text="{Binding QRFileName}" />
                <Image Name="QRCodeImage" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="复制文件地址">
                        <materialDesign:PackIcon Kind="ContentCopy" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="下载文件" IsEnabled="False">
                        <materialDesign:PackIcon Kind="CloudDownloadOutline" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <TabControl Grid.Column="1" SelectedIndex="0" Foreground="DimGray" BorderThickness="1,0,0,0">

                <!-- 原有的文件管理页面 -->
                <TabItem Header="文件管理">
                    <DockPanel>
                        <Border BorderBrush="LightGray" BorderThickness="0 1 0 1" DockPanel.Dock="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="120"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <TextBox VerticalAlignment="Center" materialDesign:HintAssist.Hint="输入文件名进行搜索" BorderThickness="0"
                                 Text="{Binding SearchText}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                                    <Button HorizontalAlignment="Left" ToolTip="搜索资源文件" Foreground="White" Command="{Binding SearchCommand}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Search" />
                                            <TextBlock Margin="8 0 0 0">搜索</TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding FileName}" />
                                <DataGridTextColumn Header="修改日期" Binding="{Binding LastModifiedText}" />
                                <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" />
                            </DataGrid.Columns>

                            <DataGrid.Resources>
                                <ContextMenu x:Key="RowContextMenu">
                                    <MenuItem Header="复制文件地址" />
                                    <MenuItem Header="下载" IsEnabled="False" />
                                </ContextMenu>
                            </DataGrid.Resources>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 原有的服务日志页面 -->
                <TabItem Header="服务日志">
                    <TextBox Name="logBox" FontSize="14" IsReadOnly="True" Cursor="IBeam"
                           Padding="8" VerticalContentAlignment="Top"
                          VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" BorderBrush="LightGray"
                          Text="{Binding LogContent}" />
                </TabItem>

                <!-- 接口测试页面：走真实链路验证 /api/share -->
                <TabItem Header="接口测试">
                    <DockPanel Margin="16">
                        <TextBlock DockPanel.Dock="Top" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="通过 HTTP 真实链路调用本机 " />
                            <Run Text="/api/share" FontWeight="Bold" Foreground="#0071cb" />
                            <Run Text=" 接口，生成一个测试文件并上传，验证整条链路（本地保存 → OSS 上传 → 二维码生成）是否正常。" />
                        </TextBlock>

                        <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="Gray" Margin="0,0,0,8"
                                   Text="{Binding ServerText}" />

                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                                Command="{Binding TestShareCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FlaskOutline" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">执行 Share 接口测试</TextBlock>
                            </StackPanel>
                        </Button>

                        <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="DarkGray" Margin="0,12,0,0"
                                   Text="测试过程与结果将记录到下方日志，请切换到“服务日志”标签查看详细信息。" />
                    </DockPanel>
                </TabItem>

                <!-- 设置：S3 存储凭据（默认自动生成 + 主动轮换） -->
                <TabItem Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">S3 存储凭据</TextBlock>
                            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,12">
                                存储后端为 <Run FontWeight="Bold">s3（MinIO）</Run>。首次运行已自动生成默认密钥并加密保存；如需更换，
                                请先在 MinIO 侧同步 filesharer 账号密码，再在此填写新凭据并保存轮换。
                            </TextBlock>

                            <TextBlock FontSize="12" Foreground="#0071cb" Margin="0,0,0,12"
                                       Text="{Binding S3StatusText}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="存储类型" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding S3StorageTypeText}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Endpoint" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding S3EndpointText}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bucket" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding S3BucketText}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AccessKey" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding S3AccessKey}" materialDesign:HintAssist.Hint="文件分享账号 AccessKey" />
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SecretKey" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding S3SecretKey}" materialDesign:HintAssist.Hint="文件分享账号 SecretKey（加密存储）" />
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding GenerateSecretCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DiceMultiple" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">生成随机密钥</TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RotateS3Command}"
                                        Style="{StaticResource MaterialDesignRaisedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">保存轮换</TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,16,0,0">
                                说明：凭据以 Windows DPAPI 加密存储于 ~/.cloud-disk.ini；轮换后需确保 MinIO 侧 filesharer
                                账号密码一致（在 AndX 服务器执行 minio-init.sh 或 mc admin user）。
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</reactiveui:ReactiveWindow>
